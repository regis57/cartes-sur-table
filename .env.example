# Copier en `.env` sur le NAS, à côté de docker-compose.yml. Ne jamais versionner `.env`.
TUNNEL_TOKEN=le-jeton-du-tunnel-cloudflare-nas-jeuxdecartes
PUBLIC_ORIGIN=https://jeuxdecartes.altiplume.com
# Nombre de tables ouvertes en même temps : ce que le processeur du NAS tient (les bots
# calculent dans des fils à part, mais se partagent le processeur). Au-delà, un nouveau venu
# lit « Le serveur est complet pour le moment ». À relever par paliers de dix.
MAX_TABLES=30
